# Copy the names into Vercel → Settings → Environment Variables (never commit real values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Phase 2 - push notifications
PUSH_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:Connect@systemmaster.in

# Phase AI-1 - encrypt organization AI provider API keys (server-only, 32+ random characters)
AI_KEY_ENCRYPTION_SECRET=

# Security - 2-step verification (server-only; use a different 32+ char random secret for each)
ORG_ADMIN_2FA_SECRET=
SYSTEM_ADMIN_2FA_SECRET=

# Gmail API sender used for security OTP emails
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER=noreply@systemmaster.in
