<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light system bars that match the app's white header (dark mode: see values-night). -->
    <style name="Theme.SMHRMS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
