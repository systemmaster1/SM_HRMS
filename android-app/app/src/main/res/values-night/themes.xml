<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Phone in dark mode: dark system bars and background while the app loads.
         After loading, the web app sets the bars to match its own theme. -->
    <style name="Theme.SMHRMS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
</resources>
